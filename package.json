{
  "name": "dsh-writeguard",
  "version": "0.2.0",
  "description": "跨会话写锁与写者协作：占锁/释放/查看，留言板、在场心跳、排队等锁，以及一个网页面板。Cross-session write locks with a coordination board and a web panel for DeepSeek Harness.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "bin": {
    "wg": "./bin/wg.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./lib/store": "./lib/store.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./client": "./client.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/",
    "bin/",
    "locale/",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node dev/smoke.mjs"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ziyepei06/dsh-writeguard.git"
  },
  "homepage": "https://github.com/ziyepei06/dsh-writeguard",
  "bugs": {
    "url": "https://github.com/ziyepei06/dsh-writeguard/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "file-lock",
    "concurrency",
    "lock",
    "multi-agent",
    "coordination"
  ],
  "publishConfig": {
    "access": "public"
  }
}
